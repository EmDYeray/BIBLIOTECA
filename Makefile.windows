CXX := g++
CXXFLAGS := -O2 -std=c++20 -Wall -Wextra -Wpedantic $(shell pkg-config --cflags sdl2 cairo fontconfig glew)
LDLIBS := $(shell pkg-config --libs sdl2 cairo fontconfig glew) -lopengl32
SOURCES := $(wildcard src/*.cpp)
OBJECTS := $(patsubst src/%.cpp,.build-windows/%.o,$(SOURCES))

.PHONY: all test clean
all: biblioteca.exe

biblioteca.exe: $(OBJECTS)
	$(CXX) $(OBJECTS) -o $@ $(LDLIBS)

.build-windows/%.o: src/%.cpp
	@mkdir -p .build-windows
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(OBJECTS:.o=.d)

test: biblioteca.exe
	./biblioteca.exe --self-test

clean:
	rm -rf .build-windows biblioteca.exe
